# O @c3theme/* vem por git e o `prepare` compila os pacotes na instalação. Com o layout
# isolado padrão do pnpm, o tsc dos pacotes resolve @types/react por um caminho temporário e
# falha com TS2883 (tipo não portável). O layout hoisted deixa os tipos em node_modules/@types,
# o que faz o build do C3Theme funcionar no install (CI e máquina limpa).
node-linker=hoisted
