{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WA MCP",
  "version": "26.10.10",
  "identifier": "com.cappyfy.wamcp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build && node scripts/copy-web.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "resources": {
      "runtime/": "runtime/"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["PortugueseBR"],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/cecon/wamcp/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDMzU2QzU2Q0E3NDQ3MzYKUldRMlIzVEtWbXcxVFBqUi9KNXpuaXplcmFQTjd6d3l5MTZCUUlOemtqK0VySkF4ckVPQTh1bzIK",
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
