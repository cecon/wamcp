{
  "identifier": "app",
  "description": "The web app served by the embedded backend, opened in the main window. Browsers on the network never get Tauri IPC.",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:17382/*"] },
  "permissions": [
    "core:default",
    "allow-runtime-status",
    "allow-configure-tunnel",
    "allow-autostart-status",
    "allow-set-autostart",
    "allow-check-update",
    "allow-install-update"
  ]
}
