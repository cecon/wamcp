    "@whiskeysockets/baileys": "7.0.0-rc14",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "lucide-react": "^1.48.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.51.0",
    "@tauri-apps/cli": "^2.0.0",
