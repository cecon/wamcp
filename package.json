{
  "name": "wamcp",
  "version": "26.10.10",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@c3theme/chat",
      "@c3theme/ui",
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "server": "cargo run --manifest-path src-tauri/Cargo.toml -p wamcp-server",
    "test": "node --test tests/*.test.mjs",
    "tauri": "tauri",
    "prepare:desktop": "node scripts/prepare-desktop.mjs",
    "desktop": "pnpm run prepare:desktop && tauri dev",
    "desktop:build": "pnpm run prepare:desktop && tauri build",
    "lint": "eslint . --max-warnings 0 && node scripts/check-architecture.mjs && node scripts/c3-progresso.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "progresso:c3": "node scripts/c3-progresso.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm run lint && pnpm run format:check && pnpm run build && pnpm test && pnpm run test:ui",
    "version": "node scripts/version.mjs",
    "test:ui": "vitest run --coverage",
    "test:server": "cargo test --manifest-path src-tauri/Cargo.toml -p wamcp-server --no-default-features",
    "coverage:server": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml -p wamcp-server --no-default-features --fail-under-lines 80"
  },
  "dependencies": {
    "@c3theme/chat": "github:cecon/C3Theme#e88cf032e5ce881730be768c6468ff72d360f511&path:packages/chat",
    "@c3theme/ui": "github:cecon/C3Theme#e88cf032e5ce881730be768c6468ff72d360f511&path:packages/ui",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@mui/material": "^9.5.0",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2.12.4",
    "iconsax-reactjs": "^0.0.8",
    "lucide-react": "^1.66.0",
    "react": "^19.0.0",
    "react-dom": "^19.3.1",
    "react-intl": "^12.1.6",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "remark-gfm": "^4.0.1",
    "stylis": "^4.2.0",
    "stylis-plugin-rtl": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.1",
    "vitest": "^5.1.0"
  }
}
