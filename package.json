{
  "name": "wamcp",
  "version": "26.10.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "server": "cargo run --manifest-path src-tauri/Cargo.toml -p wamcp-server",
    "test": "node --test tests/*.test.mjs",
    "tauri": "tauri",
    "prepare:desktop": "node scripts/prepare-desktop.mjs",
    "desktop": "npm run prepare:desktop && tauri dev",
    "desktop:build": "npm run prepare:desktop && tauri build",
    "lint": "eslint . --max-warnings 0 && node scripts/check-architecture.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run build && npm test && npm run test:ui",
    "version": "node scripts/version.mjs",
    "test:ui": "vitest run --coverage",
    "test:server": "cargo test --manifest-path src-tauri/Cargo.toml -p wamcp-server --no-default-features",
    "coverage:server": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml -p wamcp-server --no-default-features --fail-under-lines 80"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^1.48.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.51.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
